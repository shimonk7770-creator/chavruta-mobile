{
  "expo": {
    "name": "חברותא",
    "slug": "chavruta-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "chavrutamobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "המיקום משמש לחישוב זמני היום, כיוון התפילה ומניינים קרובים.",
        "NSMicrophoneUsageDescription": "המיקרופון משמש להקלטה קולית של פוסטים.",
        "NSPhotoLibraryUsageDescription": "הגישה לגלריה משמשת לצירוף תמונות ווידאו לפוסטים."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1f6f5c",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "הגישה לגלריה משמשת לצירוף תמונות ווידאו."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "המיקום משמש לזמני היום, כיוון התפילה ומניינים קרובים."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true,
      "baseUrl": "/app"
    }
  }
}